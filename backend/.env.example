NODE_ENV=development
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://vin:vin@localhost:5432/vin

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Used to derive the AES-256-GCM key that encrypts the AI provider API keys
# stored per household. Use a long random passphrase (e.g. `openssl rand -hex 32`).
API_KEY_ENCRYPTION_SECRET=change-me-too

# Where uploaded label photos are stored (mounted as a persistent volume in Coolify)
STORAGE_DIR=/data/photos
