<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".VinApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.Vin"
        android:usesCleartextTraffic="true">
        <!--
          usesCleartextTraffic=true: a self-hosted Coolify instance may not
          always sit behind HTTPS (e.g. reached over a local network/VPN
          during setup). Tighten this (and add a network security config
          restricting it to the configured host) once the server is
          confirmed to always be served over HTTPS.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Vin">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
